rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && request.auth.uid == "t44mtOdTbnUt1mep3ZIg6dYkD0C2";}
  function active(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;}
  match /users/{id}{
   allow read: if admin() || (signedIn() && request.auth.uid == id);
   allow create: if admin() || (signedIn() && request.auth.uid == id && request.resource.data.role == "member" && request.resource.data.active == true);
   allow update, delete: if admin();
  }
  match /messages/{id}{
   allow read: if active();
   allow create: if active() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
   allow update, delete: if admin();
  }
 }
}